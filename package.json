{
  "name": "mach-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Nhật ký số cá nhân cho macOS — local-first activity journal",
  "author": "Mach",
  "main": "desktop/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "desktop": "npm run build:helper && npm run build && electron .",
    "desktop:dev": "npm run build:helper && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "test": "node --import tsx --test tests/*.test.*",
    "test:e2e": "playwright test",
    "dist:mac": "npm run build:helper && npm run build && electron-builder --mac --publish never",
    "build:helper": "node desktop/build-helper.cjs",
    "build:preview": "tsc -b && vite build --mode standalone"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "local.mach.desktop",
    "productName": "Mach",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "desktop/**/*",
      "!desktop/helpers/mach-foreground",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "icon": "public/icons/icon.icns"
    },
    "extraResources": [
      {
        "from": "desktop/helpers/mach-foreground",
        "to": "helpers/mach-foreground"
      }
    ]
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
