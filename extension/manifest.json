{
  "manifest_version": 3,
  "name": "Mạch — Nhật ký duyệt web",
  "version": "0.1.0",
  "description": "Kết nối với Mạch trên Mac để hiểu thời gian duyệt web của chính bạn. Dữ liệu chỉ gửi về máy này.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "alarms",
    "idle",
    "scripting"
  ],
  "optional_permissions": [
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:43821/*"
  ],
  "optional_host_permissions": [
    "https://x.com/*",
    "https://twitter.com/*",
    "https://www.reddit.com/*",
    "https://old.reddit.com/*",
    "https://reddit.com/*"
  ],
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mạch — trạng thái ghi hoạt động",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
